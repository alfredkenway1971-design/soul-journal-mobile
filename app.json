{
  "expo": {
    "name": "Soul Journal",
    "slug": "soul-journal",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "souljournal",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#cbe4f6",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#e8e7e9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.souljournal.app",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      }
    },
    "android": {
      "package": "com.souljournal.app",
      "adaptiveIcon": {
        "backgroundColor": "#8FCFA8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-font",
      "expo-splash-screen",
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#1d81ed"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-speech-recognition",
      "expo-sharing",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "1ebcd728-5a78-447c-8b30-fab586065897"
      }
    },
    "owner": "zechs05"
  }
}
